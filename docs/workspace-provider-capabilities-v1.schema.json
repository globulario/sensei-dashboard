{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globulario.github.io/sensei-dashboard/schema/workspace-provider-capabilities-v1.json",
  "title": "Sensei Dashboard Workspace Provider Capabilities V1",
  "description": "Explicit, bounded capability support for one agent provider (docs/architecture-workspace-v1.md §6, docs/claude-workspace-o1-brief.md §4.1). The common abstraction must not pretend every provider has identical authentication, MCP, streaming, resume, sandboxing, approval, or structured-output support -- a boolean is insufficient when support depends on runtime mode, hence the four-state enum.",
  "$comment": "schema_version is a const. Dashboard/runner-owned per claude-workspace-o1-brief.md §11.1/§A.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "runtime", "capabilities", "recorded_at"],
  "properties": {
    "schema_version": { "const": "sensei.dashboard.provider-capabilities.v1" },
    "provider_id": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interactive_auth",
        "browser_auth",
        "headless_execution",
        "streaming_output",
        "session_resume",
        "mcp",
        "skills",
        "sandboxing",
        "command_approvals",
        "file_approvals",
        "structured_output"
      ],
      "properties": {
        "interactive_auth": { "$ref": "#/$defs/supportState" },
        "browser_auth": { "$ref": "#/$defs/supportState" },
        "headless_execution": { "$ref": "#/$defs/supportState" },
        "streaming_output": { "$ref": "#/$defs/supportState" },
        "session_resume": { "$ref": "#/$defs/supportState" },
        "mcp": { "$ref": "#/$defs/supportState" },
        "skills": { "$ref": "#/$defs/supportState" },
        "sandboxing": { "$ref": "#/$defs/supportState" },
        "command_approvals": { "$ref": "#/$defs/supportState" },
        "file_approvals": { "$ref": "#/$defs/supportState" },
        "structured_output": { "$ref": "#/$defs/supportState" }
      }
    },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "supportState": {
      "type": "string",
      "enum": ["supported", "unsupported", "unknown", "conditional"]
    }
  }
}
